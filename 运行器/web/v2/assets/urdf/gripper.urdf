<robot
  name="gripper">
  <!-- 工具坐标系（新的根）：手指伸出方向 = +Z，符合末端执行器惯例。
       原来的 gripper_base_link 是 SolidWorks 导出的装配体坐标系，手指朝 +Y。
       这里不去改动那一大堆关节原点/轴/mimic 系数（改一处错一处），而是加一节
       fixed joint 把整个模型绕 X 转 +90°：base 的 +Y → mount 的 +Z。
       X（两指开合方向）保持不变。 -->
  <link
    name="gripper_mount" />
  <joint
    name="gripper_mount_joint"
    type="fixed">
    <origin
      xyz="0 0 0"
      rpy="1.5707963 0 0" />
    <parent
      link="gripper_mount" />
    <child
      link="gripper_base_link" />
  </joint>
  <link
    name="gripper_base_link">
    <inertial>
      <origin
        xyz="0.00091117 0.0065095 -0.01463"
        rpy="0 0 0" />
      <mass
        value="0.065014" />
      <inertia
        ixx="3.3783E-05"
        ixy="-2.5689E-07"
        ixz="9.1004E-07"
        iyy="4.4723E-05"
        iyz="2.8879E-06"
        izz="2.0637E-05" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://gripper/meshes/gripper_base_link.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://gripper/meshes/gripper_base_link.STL" />
      </geometry>
    </collision>
  </link>
  <link
    name="link_gear1">
    <inertial>
      <origin
        xyz="-0.00807490304907014 0.0107570544809771 0.00470516629266777"
        rpy="0 0 0" />
      <mass
        value="0.00474977495749991" />
      <inertia
        ixx="7.83389362892289E-07"
        ixy="5.82559425757126E-07"
        ixz="1.77089643142207E-10"
        iyy="6.4630220451341E-07"
        iyz="-1.67800639848209E-10"
        izz="1.40127565418021E-06" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://gripper/meshes/link_gear1.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://gripper/meshes/link_gear1.STL" />
      </geometry>
    </collision>
  </link>
  <!-- 驱动关节：关节值直接就是舵机指令角（0~110°，弧度制 0~1.91987）。
       标定点：90° = 连杆平行状态；110° = 夹爪基本合拢（实物手指柔性，
       会自己夹紧，所以刚体模型在 ~98° 之后会出现指面互相穿透，属预期，不必处理）。
       0° 时张开约 92mm。

       原始导出里关节值是机构几何角 q，这里通过 origin 预转 +50° + axis 取反
       换算成指令角坐标：q = 50° - 关节值。origin 的 rpy 与 axis 同为 Z 轴、
       可交换，Rz(50°)·Rz(-s) = Rz(q)，所以子连杆位置与原来完全一致，
       只是关节读数的零点和方向变了。 -->
  <joint
    name="joint_gear1"
    type="revolute">
    <origin
      xyz="-0.013 0.03 -0.0217"
      rpy="0 0 0.8726646" />
    <parent
      link="gripper_base_link" />
    <child
      link="link_gear1" />
    <axis
      xyz="0 0 -1" />
    <limit
      lower="0"
      upper="1.91987"
      effort="0"
      velocity="0" />
  </joint>
  <link
    name="link_finger1">
    <inertial>
      <origin
        xyz="-0.00872921596551027 0.0101576300716104 0.0228999998374587"
        rpy="0 0 0" />
      <mass
        value="0.0199992813021374" />
      <inertia
        ixx="4.35103993894113E-06"
        ixy="-8.22954317741796E-07"
        ixz="-2.86563653886116E-08"
        iyy="2.17742276586541E-06"
        iyz="-1.11363506800047E-07"
        izz="5.34363768417929E-06" />
    </inertial>
    <visual>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://gripper/meshes/link_finger1.STL" />
      </geometry>
      <material
        name="">
        <color
          rgba="1 1 1 1" />
      </material>
    </visual>
    <collision>
