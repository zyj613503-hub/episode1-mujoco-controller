        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://gripper/meshes/link_finger1.STL" />
      </geometry>
    </collision>
  </link>
  <!-- 平行四边形的连杆：手指相对 gear1 反向转，绝对姿态保持不变（平行夹持）。
       需要 值 = -q = 关节值 - 50°，故 multiplier=1、offset=-50°。 -->
  <joint
    name="joint_finger1"
    type="revolute">
    <origin
      xyz="-0.025471 0.030842 -0.0012"
      rpy="0 0 0" />
    <parent
      link="link_gear1" />
    <child
      link="link_finger1" />
    <axis
      xyz="0 0 1" />
    <limit
      lower="-0.8727"
      upper="1.0473"
      effort="0"
      velocity="0" />
    <mimic
      joint="joint_gear1"
      multiplier="1"
      offset="-0.8726646" />
  </joint>
